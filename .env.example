# Copy to .env.local and fill in to use the AI judge. Without these, the app
# falls back to a lenient local rule-based judge (fine for UI work).
#
# The function URL looks like https://<project-ref>.supabase.co/functions/v1/judge
# For `supabase functions serve` locally: http://127.0.0.1:54321/functions/v1/judge
EXPO_PUBLIC_JUDGE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
