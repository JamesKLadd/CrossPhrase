# Copy to .env.local, fill in what you use, then restart with `npx expo start --clear`.
# Leave everything empty and the game still works: the built-in judge runs on the phone.

# The free PC judge (Gemma 4 E2B on your computer). `npm run pc-judge` prints this
# line with your computer's address. Your phone must be on the same Wi-Fi.
EXPO_PUBLIC_JUDGE_URL=

# A PIN for the hidden labelling screen (long-press the owl on the home screen).
# Leave empty to switch the screen off, e.g. for builds you give to friends.
EXPO_PUBLIC_DEV_PIN=

# Optional, paid, off by default: the Claude judge on Supabase (see README).
# Only used when EXPO_PUBLIC_JUDGE_URL is empty.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
