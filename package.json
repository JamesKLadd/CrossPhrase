{
  "name": "crossphrase",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "expo": "~54.0.37",
    "expo-constants": "~18.0.14",
    "expo-haptics": "~15.0.8",
    "expo-linking": "~8.0.12",
    "expo-router": "~6.0.24",
    "expo-sqlite": "~16.0.10",
    "expo-status-bar": "~3.0.9",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-web": "^0.21.4",
    "react-native-worklets": "0.5.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@types/jest": "29.5.14",
    "@types/node": "^22.20.5",
    "@types/react": "~19.1.10",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~10.0.0",
    "jest": "~29.7.0",
    "jest-expo": "~54.0.18",
    "tsx": "^4.23.15",
    "typescript": "~5.9.2"
  },
  "scripts": {
    "prestart": "node scripts/check-node.mjs",
    "start": "expo start",
    "preandroid": "node scripts/check-node.mjs",
    "android": "expo start --android",
    "preios": "node scripts/check-node.mjs",
    "ios": "expo start --ios",
    "preweb": "node scripts/check-node.mjs",
    "web": "expo start --web",
    "test": "jest",
    "typecheck": "tsc --noEmit && tsc --noEmit -p pc-judge",
    "lint": "expo lint",
    "build:words": "python3 scripts/build_words.py",
    "test:db": "node --test supabase/tests/database.test.mjs",
    "test:functions": "deno test --no-lock supabase/functions",
    "train:judge": "tsx scripts/train-judge.ts",
    "pc-judge": "tsx pc-judge/server.ts",
    "pc-judge:setup": "tsx pc-judge/setup.ts",
    "test:pc-judge": "tsx --test pc-judge/app.test.ts"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "<rootDir>/supabase/",
      "<rootDir>/pc-judge/"
    ]
  },
  "engines": {
    "node": ">=20.19.4"
  }
}
