{
  "name": "crossphrase",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "expo": "~57.0.30",
    "expo-asset": "~57.0.20",
    "expo-audio": "~57.0.5",
    "expo-constants": "~57.0.22",
    "expo-haptics": "~57.0.3",
    "expo-linking": "~57.0.13",
    "expo-router": "~57.0.28",
    "expo-sqlite": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.4",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@react-native/jest-preset": "^0.86.3",
    "@types/jest": "29.5.14",
    "@types/node": "^22.20.5",
    "@types/react": "~19.2.4",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.2",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.6",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "prestart": "node scripts/check-node.mjs",
    "start": "expo start",
    "preandroid": "node scripts/check-node.mjs",
    "android": "expo start --android",
    "preios": "node scripts/check-node.mjs",
    "ios": "expo start --ios",
    "preweb": "node scripts/check-node.mjs",
    "web": "expo start --web",
    "test": "jest",
    "typecheck": "tsc --noEmit && tsc --noEmit -p pc-judge",
    "lint": "expo lint",
    "build:words": "python3 scripts/build_words.py",
    "test:db": "node --test supabase/tests/database.test.mjs",
    "test:functions": "deno test --no-lock supabase/functions",
    "train:judge": "tsx scripts/train-judge.ts",
    "generate:levels": "tsx scripts/generate-levels.ts",
    "make:sounds": "node scripts/make-sounds.mjs",
    "pc-judge": "tsx pc-judge/server.ts",
    "pc-judge:setup": "tsx pc-judge/setup.ts",
    "test:pc-judge": "tsx --test pc-judge/app.test.ts"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "<rootDir>/supabase/",
      "<rootDir>/pc-judge/"
    ]
  },
  "engines": {
    "node": "^20.19.4 || ^22.13.0 || ^24.3.0 || >=25.0.0"
  }
}
